{
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": ["/images/*", "/*.{css,scss,js,png,jpg,jpeg,gif,ico,svg,woff,woff2,ttf,eot}"]
  },
  "routes": [
    { "route": "/admin/*", "allowedRoles": ["authenticated"] }
  ],
  "responseOverrides": {
    "404": { "rewrite": "/index.html" }
  }
}
